# ==============================================================================
# FarmGrade — Environment Variables & Deployment Configuration
# ==============================================================================
#
# IMPORTANT SECURITY NOTES:
# 1. Never commit active API keys, passwords, or database credentials to version control.
# 2. Never prefix secret variables with VITE_ as that exposes them to the client bundle.
# 3. All AI, OAuth, and database calls are handled securely server-side via Express routes (/api/*).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Gemini AI Integration (Server-Side Only)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ------------------------------------------------------------------------------
# 3. Application Hosting & URL
# ------------------------------------------------------------------------------
APP_URL="https://your-app-domain.run.app"

# ------------------------------------------------------------------------------
# 4. Database Connection
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://farmgrade_user:password@localhost:5432/farmgrade_db"

# ------------------------------------------------------------------------------
# 5. Session & Authentication Security
# ------------------------------------------------------------------------------
# AUTH_SECRET="your-secure-random-secret-key-at-least-32-chars"
# GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# SMS_OTP_PROVIDER_KEY="your-sms-gateway-api-key"
